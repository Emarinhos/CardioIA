    {
        "id": "c4a1e8b27d0f4a31",
        "type": "function",
        "z": "7d65e81e9d19f280",
        "name": "Hora temperatura",
        "func": "var dataHora;\nif (msg.payload !== null && typeof msg.payload === \"object\") {\n    dataHora = msg.payload.data_hora;\n    msg.payload = msg.payload.temperatura;\n} else {\n    dataHora = msg.data_hora;\n}\nif (typeof dataHora === \"string\" && dataHora !== \"sem-relogio\") {\n    var ms = Date.parse(dataHora);\n    if (isFinite(ms)) {\n        msg.timestamp = ms;\n        return msg;\n    }\n}\nvar instante = Number(msg.timestamp);\nif (!isFinite(instante)) {\n    return msg;\n}\nvar maior = context.get(\"maiorInstante\") || 0;\nif (instante > maior) {\n    maior = instante;\n    context.set(\"maiorInstante\", maior);\n}\nmsg.timestamp = Date.now() - maior + instante;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 890,
        "y": 380,
        "wires": [
            [
                "66a0e114bea71d93"
            ]
        ]
    },
    {
        "id": "d5b2f9c38e104b42",
        "type": "function",
        "z": "7d65e81e9d19f280",
        "name": "Hora BPM",
        "func": "var dataHora;\nif (msg.payload !== null && typeof msg.payload === \"object\") {\n    dataHora = msg.payload.data_hora;\n    msg.payload = msg.payload.bpm;\n} else {\n    dataHora = msg.data_hora;\n}\nif (typeof dataHora === \"string\" && dataHora !== \"sem-relogio\") {\n    var ms = Date.parse(dataHora);\n    if (isFinite(ms)) {\n        msg.timestamp = ms;\n        return msg;\n    }\n}\nvar instante = Number(msg.timestamp);\nif (!isFinite(instante)) {\n    return msg;\n}\nvar maior = context.get(\"maiorInstante\") || 0;\nif (instante > maior) {\n    maior = instante;\n    context.set(\"maiorInstante\", maior);\n}\nmsg.timestamp = Date.now() - maior + instante;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 890,
